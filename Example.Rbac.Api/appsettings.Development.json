{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "Jwt": {
    "Key": "",
    "TokenExpirationInMinutes": 5,
    "Issuer": "", // Quien firmo el token, al llegar al server verifica que el token fue firmado por el mismo issuer que esta configurado en el server. Evita que un token firmado de otro server sea aceptado.
    "Audience": "" // Quien puede usar el token, al llegar al server verifica que el token fue firmado para el mismo audience que esta configurado en el server. Evita que un token de otro sistema sea aceptado si no fue generado para este servicio.
  }
}
